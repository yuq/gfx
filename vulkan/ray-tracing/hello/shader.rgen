#version 460
#extension GL_EXT_ray_tracing : enable

layout(location = 0) rayPayloadEXT vec4 payload;
layout(binding = 0, set = 0) uniform accelerationStructureEXT acc;
layout(binding = 1, set = 0, rgba8) uniform image2D img;

void main()
{
  vec2 pos = vec2(gl_LaunchIDEXT.xy + 0.5);
  payload = vec4(0, 0, 0, 1);

  traceRayEXT(acc, gl_RayFlagsOpaqueEXT, 0xff,
              0, 0, /* hit shader offset and stride */
	      0, /* miss shader index */
	      vec3(pos, 0), /* origin */
	      0.001, /* t-min */
              vec3(0, 0, 1), /* dir */
              1000, /* t-max */
	      0 /* payload */);

  imageStore(img, ivec2(gl_LaunchIDEXT), payload);
}
